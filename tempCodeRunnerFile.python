from datetime import datetime
import winsound
#from playsound import playsound                These are for when we use notebook
#from Ipython.display import Audio, Display
now = datetime.now()
print(now)
current_hour = now.strftime("%I")
print(current_hour)
current_minute = now.strftime("%M")
print(current_minute)
current_seconds = now.strftime("%S")
print(current_seconds)
current_period = now.strftime("%p")
print(current_period)
alarm_time = input("enter the time of alarm to be set:HH:MM:SS:PP\n")
alarm_hour = alarm_time[0:2]
alarm_minute = alarm_time[3:5]
alarm_seconds = alarm_time[6:8]
alarm_period = alarm_time[9:11].upper()
print("setting up alarm..")
print("Alarm Setup complete!")
while 1:
    now = datetime.now()
    current_hour = now.strftime("%I")
    current_minute = now.strftime("%M")
    current_seconds = now.strftime("%S")
    current_period = now.strftime("%p")
    if alarm_period == current_period:
        if alarm_hour == current_hour:
            if alarm_minute == current_minute:
                if alarm_seconds == current_seconds:
                    print("Wake up !")
                    winsound.PlaySound("Alarm.wav", winsound.SND_FILENAME)
                    #display(Audio('Alarm.wav', autoplay=True))
                    #Ipython.display.Audio('Alarm.wav')
                    break